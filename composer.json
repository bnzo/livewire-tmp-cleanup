{
    "name": "bnzo/livewire-tmp-cleanup",
    "description": "Schedule-driven cleanup of Livewire temporary uploads on S3-compatible storage (Cloudflare R2, AWS S3, MinIO). Built for Laravel Cloud users who can't use S3 lifecycle rules.",
    "keywords": [
        "laravel",
        "livewire",
        "laravel-cloud",
        "cloudflare-r2",
        "r2",
        "s3",
        "cleanup",
        "temporary-files"
    ],
    "homepage": "https://github.com/bnzo/livewire-tmp-cleanup",
    "license": "MIT",
    "authors": [
        {
            "name": "bnzo",
            "email": "17174973+bnzo@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.3",
        "larastan/larastan": "^2.9 || ^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "phpstan/phpstan": "^1.10 || ^2.0"
    },
    "suggest": {
        "livewire/livewire": "Required if you actually want to clean up Livewire's temp uploads (^3.0 || ^4.0)."
    },
    "autoload": {
        "psr-4": {
            "Bnzo\\LivewireTmpCleanup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bnzo\\LivewireTmpCleanup\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "rector": "vendor/bin/rector process --dry-run",
        "rector:fix": "vendor/bin/rector process"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bnzo\\LivewireTmpCleanup\\LivewireTmpCleanupServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
